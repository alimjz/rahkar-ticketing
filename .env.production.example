# Production environment template for Rahkar.
# Copy to .env.production or merge into the deployment secret store.
NODE_ENV=production
DEMO_MODE=false
DATABASE_URL=postgresql://rahkar:CHANGE_ME@localhost:5432/rahkar
DATABASE_SSL=false
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_URL=https://tickets.example.com
COOKIE_SECURE=true
AD_ENABLED=false
